// Week 3 - L1: Simple Book Record Class
public class BookRecord {
    public static void main(String[] args) {
        Book book = new Book();
        book.title = "Clean Code";
        book.price = 650.0;

        System.out.println("Title: " + book.title + " | Price: Rs " + book.price);
    }
}

class Book {
    String title;
    double price;
}