// Week 6 - M5: Employee and Company Information Management
public class CompanyInfoDemo {
    public static void main(String[] args) {
        new Employee("Divya", 65000);
        new Employee("Arjun", 40000);
        new Employee("Meena", 72000);

        Employee.printCompanyInfo();   // called through the class name
    }
}

class Employee {
    // instance fields — each employee has its own
    String empName;
    double salary;

    // static fields — one shared copy for all employees
    static String companyName = "Bright Horizon Technologies";
    static int employeeCount = 0;

    public Employee(String empName, double salary) {
        this.empName = empName;
        this.salary = salary;
        employeeCount++;
    }

    // static method: uses only static fields, no instance fields
    static void printCompanyInfo() {
        System.out.println(companyName);
        System.out.println("Employees on record: " + employeeCount);
    }
}