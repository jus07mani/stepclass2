// Week 6 - M2: Payroll Salary Management
public class PayrollDemo {
    public static void main(String[] args) {
        PayrollAccount account = new PayrollAccount(50000);
        account.creditBonus(5000);
        account.deductTax(10);
        System.out.println("Net salary: Rs " + account.getNetSalary());

        System.out.println("\n--- Invalid input checks ---");
        PayrollAccount bad = new PayrollAccount(-2000);
        bad.creditBonus(-100);
        bad.deductTax(150);
        System.out.println("Net salary: Rs " + bad.getNetSalary());
    }
}

class PayrollAccount {
    private double basicSalary;
    private double bonus;

    public PayrollAccount(double openingSalary) {
        if (openingSalary < 0) {
            System.out.println("Warning: negative salary given, starting at 0");
            this.basicSalary = 0;
        } else {
            this.basicSalary = openingSalary;
        }
        this.bonus = 0;
    }

    public void creditBonus(double amount) {
        if (amount <= 0) {
            System.out.println("Bonus rejected: amount must be greater than 0");
            return;
        }
        bonus += amount;
        System.out.println("Bonus credited: Rs " + amount);
    }

    public void deductTax(double percent) {
        if (percent < 0 || percent > 100) {
            System.out.println("Tax rejected: percent must be between 0 and 100");
            return;
        }
        basicSalary -= basicSalary * percent / 100;
        // print 10 instead of 10.0 when the percent is a whole number
        String shown = (percent == Math.floor(percent)) ? String.valueOf((int) percent) : String.valueOf(percent);
        System.out.println("Tax deducted: " + shown + "%");
    }

    public double getNetSalary() {
        return basicSalary + bonus;
    }
}